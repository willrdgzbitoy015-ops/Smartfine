# Files left out of the project upload to EAS Build. When this file exists it
# is used INSTEAD of .gitignore, so the .gitignore entries are repeated here.

# The backend runs on the PC, not inside the app. Leaving it out also keeps
# the student database, uploads and .env off Expo's build servers.
/server

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

.notes
