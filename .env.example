# Copy this file to .env and fill it in.
#
# Public HTTPS address of the SmartFine backend, used by the app on phones and
# tablets (for example an ngrok tunnel: ngrok http 127.0.0.1:3000).
# The web version always uses http://localhost:3000.
# EXPO_PUBLIC_ values are built into the app: put only the URL here, never a secret.
EXPO_PUBLIC_API_URL=https://your-tunnel.example.com
