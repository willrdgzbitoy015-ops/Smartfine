{
  "expo": {
    "name": "SmartFine",
    "slug": "SmartFine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/smartfine-logo.png",
    "scheme": "smartfine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.willbitoy.smartfine",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/smartfine-logo.png",
        "backgroundColor": "#173A73"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/smartfine-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/smartfineNoBG.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#173A73",
          "dark": {
            "image": "./assets/branding/smartfineNoBG.png",
            "backgroundColor": "#173A73"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartFine to use the camera to scan student QR codes and take evidence photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow SmartFine to use the camera to scan student QR codes and take evidence photos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a88fbbd4-7b66-463c-bbd7-3de454b363c2"
      }
    },
    "owner": "gowren"
  }
}
