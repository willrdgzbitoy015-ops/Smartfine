# Copy this file to server/.env and fill it in. Never commit server/.env.
# Every setting is optional unless noted; empty means "use the default".

# ---------------------------------------------------------------- server
# Port the API listens on (default 3000; the web app expects 3000).
PORT=

# Key that signs sign-in tokens, at least 16 characters. Empty: SmartFine creates server/.signing-key once.
SMARTFINE_SECRET=

# Seconds of inactivity before sign-out (default 900 = 15 minutes).
SMARTFINE_IDLE_SECONDS=

# Key that signs short-lived evidence-photo links. Empty: a new random key on every start.
EVIDENCE_LINK_SECRET=

# ---------------------------------------------------------------- email (one-time codes)
# Gmail address that sends verification and password-reset codes. Needed for first sign-in of new accounts.
SMARTFINE_EMAIL_USER=
# Gmail app password for that address (Google Account > Security > App passwords), not the normal password.
SMARTFINE_EMAIL_APP_PASSWORD=

# ---------------------------------------------------------------- PayMongo (GCash payments)
# PayMongo secret key, sk_test_... for test mode. Online payments are off without it.
PAYMONGO_SECRET_KEY=
# Webhook signing secret (written by `node setup-paymongo-webhook.js https://your-tunnel.example.com`).
PAYMONGO_WEBHOOK_SECRET=
# Webhook id (also written by setup-paymongo-webhook.js).
PAYMONGO_WEBHOOK_ID=
# Public address PayMongo sends the student back to after paying. Empty: the address the app used.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- encrypted backups
# Backup encryption key, at least 16 characters; keep a copy somewhere safe. Empty: SmartFine creates server/.backup-key once.
SMARTFINE_BACKUP_KEY=
# Hour of the daily automatic backup, 0-23 (default 2).
SMARTFINE_BACKUP_HOUR=
# Set to "off" to turn off automatic backups.
SMARTFINE_BACKUP_SCHEDULE=
# How many automatic backups to keep (default 14, minimum 3).
SMARTFINE_BACKUP_KEEP=

# ---------------------------------------------------------------- first install (node init-db.js)
# The first administrator account created by init-db.js. Only read by init-db.js;
# you can remove these lines after the database exists.
INIT_ADMIN_USERNAME=
INIT_ADMIN_EMAIL=
# Must follow the password rules: 8-72 characters with upper and lower case, a number and a special character.
# Put it in double quotes if it contains # (otherwise everything after # is read as a comment).
INIT_ADMIN_PASSWORD=

# ---------------------------------------------------------------- tests only
# Do not set these in normal use.
# PAYMONGO_API_BASE=             (tests only) PayMongo API address, default https://api.paymongo.com
# SMARTFINE_BACKUP_EVERY_SECONDS= (tests only) make a backup every N seconds instead of daily
# SMARTFINE_BACKUP_CHECK_SECONDS= (tests only) how often the scheduler checks, default 20
# SMARTFINE_BACKUP_DIR=           (tests only) backup folder, default server/backups
