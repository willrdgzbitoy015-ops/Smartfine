ative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="373"/><mxPoint x="1150" y="406"/></Array></mxGeometry></mxCell><mxCell id="n100" value="«include»" style="exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="505"/><mxPoint x="1150" y="406"/></Array></mxGeometry></mxCell><mxCell id="n101" value="«include»" style="edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n23" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n102" value="«include»" style="edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n103" value="«extend»" style="edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n32" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n104" value="«include»" style="edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n42" target="n49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n105" value="«include»" style="edgeStyle=none;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;html=1;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=2;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n47" target="n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n106" value="&lt;b&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;• Stick figure = actor (a user or an external system).&lt;br&gt;• Oval = use case (something the system does for an actor).&lt;br&gt;• Solid line = actor takes part in the use case.&lt;br&gt;• Hollow triangle = generalization: the child actor can do everything its parent can.&lt;br&gt;• «include» = the use case always uses the other one.&lt;br&gt;• «extend» = optional behaviour added to a use case.&lt;br&gt;• Every function except Log In and Reset Forgotten Password needs a signed-in, active account.&lt;br&gt;• Administrators can do all Staff functions too." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1967.5" width="270" height="235" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>