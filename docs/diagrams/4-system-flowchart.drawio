<mxfile host="app.diagrams.net" agent="SmartFine" version="24.0.0"><diagram id="page1" name="4. System Flowchart"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SmartFine: A Student Fines Monitoring and Management System" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=20;fontStyle=1;fontColor=#173A73;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2360" height="30" as="geometry"/></mxCell><mxCell id="n3" value="System Flowchart" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=16;fontStyle=1;fontColor=#2E9D43;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2360" height="26" as="geometry"/></mxCell><mxCell id="n4" value="Complete workflow of SmartFine from input to output (standard flowchart symbols)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;fontStyle=0;fontColor=#6B7689;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="2360" height="22" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;fillColor=#173A73;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="2360" height="2" as="geometry"/></mxCell><mxCell id="n6" value="A. Sign in and verification" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#F4F8FD;strokeColor=#5B7DB1;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="1520" height="890" as="geometry"/></mxCell><mxCell id="n7" value="B. Using SmartFine (what each role does)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#F3FAF5;strokeColor=#4DA862;dashed=1;" vertex="1" parent="1"><mxGeometry x="1566" y="122" width="836" height="890" as="geometry"/></mxCell><mxCell id="n8" value="C. Every request is checked on the server, saved and recorded" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#FFFBF0;strokeColor=#D6B656;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="2372" height="600" as="geometry"/></mxCell><mxCell id="n9" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#DFF3E3;strokeColor=#2E9D43;strokeWidth=2;fontColor=#1B2437;" vertex="1" parent="1"><mxGeometry x="32" y="398" width="96" height="44" as="geometry"/></mxCell><mxCell id="n10" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="155" y="403" width="34" height="34" as="geometry"/></mxCell><mxCell id="n11" value="Enter username or email and password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fontSize=11;fillColor=#DFF3E3;strokeColor=#4DA862;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="222" y="385" width="156" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Check the required fields (client and server)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE7F8;strokeColor=#5B7DB1;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="399" y="387" width="142" height="66" as="geometry"/></mxCell><mxCell id="n13" value="Account found, ACTIVE and not locked?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;st