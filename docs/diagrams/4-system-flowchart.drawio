ometry"/></mxCell><mxCell id="n27" value="Enter the 6-digit code" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fontSize=11;fillColor=#DFF3E3;strokeColor=#4DA862;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1165" y="670" width="170" height="60" as="geometry"/></mxCell><mxCell id="n28" value="Code valid? (10 min, 5 tries, used once)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1162" y="777" width="176" height="106" as="geometry"/></mxCell><mxCell id="n29" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="1363" y="813" width="34" height="34" as="geometry"/></mxCell><mxCell id="n30" value="Choose your own password; it is saved as a bcrypt hash" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fontSize=11;fillColor=#DFF3E3;strokeColor=#4DA862;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1155" y="917" width="190" height="66" as="geometry"/></mxCell><mxCell id="n31" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="1511" y="403" width="34" height="34" as="geometry"/></mxCell><mxCell id="n32" value="Which role?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1565" y="372" width="130" height="96" as="geometry"/></mxCell><mxCell id="n33" value="Student: view my fines, fine details and evidence photos" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=11;fillColor=#E6DDF3;strokeCo