ent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="1894.5"/><mxPoint x="668" y="1894.5"/></Array></mxGeometry></mxCell><mxCell id="n63" value="Yes" style="exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n33" target="n35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="812" y="1838"/></Array></mxGeometry></mxCell><mxCell id="n64" value="" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n34" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n65" value="GCash" style="exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;startArrow=oval;startFill=0;startSize=7;endArrow=open;endSize=9;strokeColor=#B8962E;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#8A6D00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="1938"/><mxPoint x="1210" y="2038"/></Array></mxGeometry></mxCell><mxCell id="n66" value="Refund webhook" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;startArrow=oval;startFill=0;startSize=7;endArrow=open;endSize=9;strokeColor=#B8962E;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#8A6D00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n37" target="n38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="2138"/></Array></mxGeometry></mxCell><mxCell id="n67" value="Cash" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n35" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n68" value="" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44546A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n38" target="n39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n69" value="&lt;b&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;• Each column (lane) is one participant: Fines Officer, Administrator, SmartFine System and Student share the school pool; PayMongo (the GCash payment gateway) is a separate pool.&lt;br&gt;• Rounded green shape = start; rounded red shape = end; rectangle = activity; diamond = decision (Yes / No or a choice).&lt;br&gt;• Solid arrow = sequence of activities inside the school pool. Dashed arrow with a circle = message sent to or from another pool (PayMongo).&lt;br&gt;• Read from top to bottom. The payment is either GCash (left to right through PayMongo) or cash at the cashier (through the Administrator); both join at the payment notices.&lt;br&gt;• The refund part only happens when the Student asks for a refund after the fine is Paid. Every step is also checked on the server and written to the Log Trail." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="2358" width="1500" height="128" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>