tyle="exitX=0;exitY=0.8775510204081632;exitDx=0;exitDy=0;entryX=1;entryY=0.375;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n6" target="n309"><mxGeometry x="-0.7" y="-8" relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="620"/><mxPoint x="335" y="880"/></Array></mxGeometry></mxCell><mxCell id="n372" value="0..1 : N  appears in" style="exitX=0;exitY=0.9591836734693877;exitDx=0;exitDy=0;entryX=1;entryY=0.3016759776536313;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n6" target="n322"><mxGeometry x="-0.78" y="-8" relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="660"/><mxPoint x="355" y="1100"/></Array></mxGeometry></mxCell><mxCell id="n373" value="1 : N  classifies" style="exitX=0;exitY=0.6194690265486725;exitDx=0;exitDy=0;entryX=1;entryY=0.3684210526315789;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n81" target="n100"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n374" value="1 : N  is paid by" style="exitX=1;exitY=0.8157894736842105;exitDx=0;exitDy=0;entryX=0;entryY=0.05952380952380952;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n152"><mxGeometry x="0" y="-10" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n375" value="1 : N  is refunded by" style="exitX=1;exitY=0.5789473684210527;exitDx=0;exitDy=0;entryX=1;entryY=0.2094017094017094;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n196"><mxGeometry x="0.34" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="410"/><mxPoint x="1360" y="165"/><mxPoint x="2260" y="165"/><mxPoint x="2260" y="820"/></Array></mxGeometry></mxCell><mxCell id="n376" value="1 : N  has photos" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n133"><mxGeometry x="0.5" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n377" value="1 : N  is read in" style="exitX=1;exitY=0.8947368421052632;exitDx=0;exitDy=0;entryX=1;entryY=0.5106382978723404;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n256"><mxGeometry x="0.84" y="-10" relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="530"/><mxPoint x="1470" y="1250"/></Array></mxGeometry></mxCell><mxCell id="n378" value="0..1 : N  announces" style="exitX=1;exitY=0.9342105263157895;exitDx=0;exitDy=0;entryX=1;entryY=0.504424778761062;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n237"><mxGeometry x="0.83" y="-10" relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="545"/><mxPoint x="1420" y="1030"/></Array></mxGeometry></mxCell><mxCell id="n379" value="1 : N  makes" style="exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n49" target="n152"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n380" value="1 : N  history" style="exitX=1;exitY=0.17857142857142858;exitDx=0;exitDy=0;entryX=0;entryY=0.32967032967032966;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n152" target="n181"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n381" value="1 : N  refunds" style="exitX=1;exitY=0.7738095238095238;exitDx=0;exitDy=0;entryX=0;entryY=0.16666666666666666;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n152" target="n196"><mxGeometry x="0.5" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="740"/><mxPoint x="1890" y="800"/></Array></mxGeometry></mxCell><mxCell id="n382" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = primary key (unique row id)&lt;br&gt;FK → table = foreign key to that table&lt;br&gt;UQ = value must be unique&lt;br&gt;Line end with a bar = exactly one&lt;br&gt;Line end with a circle and a bar = zero or one (optional)&lt;br&gt;Line end with a crow's foot = many (zero or more)&lt;br&gt;Each line is labelled with its relationship, e.g. &amp;quot;1 : N&amp;quot; (one to many) and &amp;quot;1 : 1&amp;quot; (one to one).&lt;br&gt;Many to many (users and fines) is resolved by the table student_fine_reads." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="960" width="250" height="330" as="geometry"/></mxCell><mxCell id="n383" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• users holds every account; role is ADMIN, FINES_OFFICER or STUDENT. Students and fines officers also have one row in students / fines_officers (1 : 1).&lt;br&gt;• fines.student_id is the student's users.id. payments.student_id points to students.id.&lt;br&gt;• Columns ending in _by, actor_user_id and student_user_id also point to users.id (who did the action) and are shown as FK → users.&lt;br&gt;• student_fine_reads is the linking table that makes users and fines many-to-many (which fines a student has opened).&lt;br&gt;• system_settings has a single row (school name, academic year) and no relationships.&lt;br&gt;• Money is stored in centavos (integer)." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="1950" y="1230" width="380" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>