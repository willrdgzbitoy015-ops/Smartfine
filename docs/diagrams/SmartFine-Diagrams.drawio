tyle="shape=mxgraph.networks.storage;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontColor=#1B2437;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2152" y="924" width="66" height="72" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Backups folder&lt;/b&gt;&lt;br&gt;encrypted (AES-256)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#1B2437;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2120" y="1000" width="130" height="60" as="geometry"/></mxCell><mxCell id="n37" value="HTTPS 443 + WSS" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n15"><mxGeometry x="-0.25" y="-16" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="HTTPS 443 + WSS" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n15"><mxGeometry x="-0.25" y="-14" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="HTTPS 443 + WSS" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n15"><mxGeometry x="-0.25" y="16" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="HTTPS 443 / WSS" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n16"><mxGeometry x="0" y="-26" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="Encrypted tunnel&lt;br&gt;(outward from the server)" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n21"><mxGeometry x="0" y="-38" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2E9D43;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n23"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n43" value="LAN" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2E9D43;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n23" target="n25"><mxGeometry x="0" y="-18" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="Ethernet / Wi-Fi LAN" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2E9D43;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n25" target="n27"><mxGeometry x="0" y="-26" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n45" value="LAN" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2E9D43;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n25" target="n29"><mxGeometry x="0" y="20" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="HTTPS: checkout and refund requests;&lt;br&gt;signed webhooks come back" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#2F5FB3;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n17"><mxGeometry x="0" y="190" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n47" value="SMTP over TLS (587)" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#7A5BA6;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n19"><mxGeometry x="0" y="100" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n48" value="Parameterized SQL&lt;br&gt;(local file)" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#B8962E;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n27" target="n31"><mxGeometry x="0.55" y="-62" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="Files&lt;br&gt;(signed links)" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#B8962E;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n27" target="n33"><mxGeometry x="0.55" y="50" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n50" value="Daily&lt;br&gt;backup" style="edgeStyle=none;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;startSize=7;endSize=7;strokeColor=#B8962E;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1B2437;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n27" target="n35"><mxGeometry x="0.55" y="46" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n51" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="441" y="451" width="28" height="28" as="geometry"/></mxCell><mxCell id="n52" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="971" y="586" width="28" height="28" as="geometry"/></mxCell><mxCell id="n53" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1271" y="586" width="28" height="28" as="geometry"/></mxCell><mxCell id="n54" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1958" y="534" width="28" height="28" as="geometry"/></mxCell><mxCell id="n55" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="786" y="396" width="28" height="28" as="geometry"/></mxCell><mxCell id="n56" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=13;fontStyle=1;fillColor=#173A73;strokeColor=#173A73;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="786" y="456" width="28" height="28" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;Data flow, for example when a student pays a fine with GCash (numbers on the diagram)&lt;/b&gt;&lt;br&gt;1.  The student's phone sends an HTTPS request (and keeps a WSS connection for live updates) over the Internet to SmartFine's public ngrok address.&lt;br&gt;2.  The Internet delivers the request to ngrok's public HTTPS endpoint.&lt;br&gt;3.  ngrok forwards it through its encrypted tunnel, which the server computer opened outward, past the firewall and router to the SmartFine server.&lt;br&gt;4.  The server checks the session and role, reads and writes the SQLite database, stores photos and writes the encrypted backups on its own disk, and records the Log Trail.&lt;br&gt;5.  The server asks PayMongo (HTTPS) for a GCash checkout; the student pays on PayMongo's page.&lt;br&gt;6.  PayMongo sends a signed webhook back through the Internet and the same ngrok tunnel; the server verifies it, marks the fine PAID and pushes a live update to the phone. Codes are sent by email through Gmail (SMTP over TLS)." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="1480" height="150" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue arrow = encrypted Internet traffic (HTTPS 443 / WSS).&lt;br&gt;Green arrow = school local network (LAN).&lt;br&gt;Purple arrow = email (SMTP over TLS).&lt;br&gt;Amber dashed arrow = files on the server computer's disk (database, uploads, backups).&lt;br&gt;Only the ngrok tunnel reaches the server from outside; the server opens it outward, so no port on the school router is opened.&lt;br&gt;The server also contacts PayMongo and Gmail through the router." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="1140" width="700" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>