;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n6" target="n322"><mxGeometry x="-0.78" y="-8" relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="660"/><mxPoint x="355" y="1100"/></Array></mxGeometry></mxCell><mxCell id="n373" value="1 : N  classifies" style="exitX=0;exitY=0.6194690265486725;exitDx=0;exitDy=0;entryX=1;entryY=0.3684210526315789;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n81" target="n100"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n374" value="1 : N  is paid by" style="exitX=1;exitY=0.8157894736842105;exitDx=0;exitDy=0;entryX=0;entryY=0.05952380952380952;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n152"><mxGeometry x="0" y="-10" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n375" value="1 : N  is refunded by" style="exitX=1;exitY=0.5789473684210527;exitDx=0;exitDy=0;entryX=1;entryY=0.2094017094017094;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n196"><mxGeometry x="0.34" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="410"/><mxPoint x="1360" y="165"/><mxPoint x="2260" y="165"/><mxPoint x="2260" y="820"/></Array></mxGeometry></mxCell><mxCell id="n376" value="1 : N  has photos" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n133"><mxGeometry x="0.5" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n377" value="1 : N  is read in" style="exitX=1;exitY=0.8947368421052632;exitDx=0;exitDy=0;entryX=1;entryY=0.5106382978723404;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n256"><mxGeometry x="0.84" y="-10" relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="530"/><mxPoint x="1470" y="1250"/></Array></mxGeometry></mxCell><mxCell id="n378" value="0..1 : N  announces" style="exitX=1;exitY=0.9342105263157895;exitDx=0;exitDy=0;entryX=1;entryY=0.504424778761062;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n100" target="n237"><mxGeometry x="0.83" y="-10" relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="545"/><mxPoint x="1420" y="1030"/></Array></mxGeometry></mxCell><mxCell id="n379" value="1 : N  makes" style="exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n49" target="n152"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n380" value="1 : N  history" style="exitX=1;exitY=0.17857142857142858;exitDx=0;exitDy=0;entryX=0;entryY=0.32967032967032966;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n152" target="n181"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n381" value="1 : N  refunds" style="exitX=1;exitY=0.7738095238095238;exitDx=0;exitDy=0;entryX=0;entryY=0.16666666666666666;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=14;startSize=14;strokeColor=#44546A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#173A73;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="n152" target="n196"><mxGeometry x="0.5" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="740"/><mxPoint x="1890" y="800"/></Array></mxGeometry></mxCell><mxCell id="n382" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = primary key (unique row id)&lt;br&gt;FK → table = foreign key to that table&lt;br&gt;UQ = value must be unique&lt;br&gt;Line end with a bar = exactly one&lt;br&gt;Line end with a circle and a bar = zero or one (optional)&lt;br&gt;Line end with a crow's foot = many (zero or more)&lt;br&gt;Each line is labelled with its relationship, e.g. &amp;quot;1 : N&amp;quot; (one to many) and &amp;quot;1 : 1&amp;quot; (one to one).&lt;br&gt;Many to many (users and fines) is resolved by the table student_fine_reads." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="960" width="250" height="330" as="geometry"/></mxCell><mxCell id="n383" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• users holds every account; role is ADMIN, FINES_OFFICER or STUDENT. Students and fines officers also have one row in students / fines_officers (1 : 1).&lt;br&gt;• fines.student_id is the student's users.id. payments.student_id points to students.id.&lt;br&gt;• Columns ending in _by, actor_user_id and student_user_id also point to users.id (who did the action) and are shown as FK → users.&lt;br&gt;• student_fine_reads is the linking table that makes users and fines many-to-many (which fines a student has opened).&lt;br&gt;• system_settings has a single row (school name, academic year) and no relationships.&lt;br&gt;• Money is stored in centavos (integer)." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FAFBFD;strokeColor=#9AA5B5;fontColor=#1B2437;dashed=1;" vertex="1" parent="1"><mxGeometry x="1950" y="1230" width="380" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4. System Flowchart"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SmartFine: A Student Fines Monitoring and Management System" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=20;fontStyle=1;fontColor=#173A73;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2360" height="30" as="geometry"/></mxCell><mxCell id="n3" value="System Flowchart" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=16;fontStyle=1;fontColor=#2E9D43;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2360" height="26" as="geometry"/></mxCell><mxCell id="n4" value="Complete workflow of SmartFine from input to output (standard flowchart symbols)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;fontStyle=0;fontColor=#6B7689;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="2360" height="22" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;fillColor=#173A73;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="2360" height="2" as="geometry"/></mxCell><mxCell id="n6" value="A. Sign in and verification" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#F4F8FD;strokeColor=#5B7DB1;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="1520" height="890" as="geometry"/></mxCell><mxCell id="n7" value="B. Using SmartFine (what each role does)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#F3FAF5;strokeColor=#4DA862;dashed=1;" vertex="1" parent="1"><mxGeometry x="1566" y="122" width="836" height="890" as="geometry"/></mxCell><mxCell id="n8" value="C. Every request is checked on the server, saved and recorded" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#173A73;fillColor=#FFFBF0;strokeColor=#D6B656;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="2372" height="600" as="geometry"/></mxCell><mxCell id="n9" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#DFF3E3;strokeColor=#2E9D43;strokeWidth=2;fontColor=#1B2437;" vertex="1" parent="1"><mxGeometry x="32" y="398" width="96" height="44" as="geometry"/></mxCell><mxCell id="n10" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="155" y="403" width="34" height="34" as="geometry"/></mxCell><mxCell id="n11" value="Enter username or email and password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fontSize=11;fillColor=#DFF3E3;strokeColor=#4DA862;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="222" y="385" width="156" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Check the required fields (client and server)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE7F8;strokeColor=#5B7DB1;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="399" y="387" width="142" height="66" as="geometry"/></mxCell><mxCell id="n13" value="Account found, ACTIVE and not locked?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="562" y="364" width="176" height="112" as="geometry"/></mxCell><mxCell id="n14" value="CAPTCHA required (after a lockout)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="762" y="364" width="176" height="112" as="geometry"/></mxCell><mxCell id="n15" value="Password matches the bcrypt hash?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="962" y="364" width="176" height="112" as="geometry"/></mxCell><mxCell id="n16" value="First sign-in (account not activated)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1162" y="364" width="176" height="112" as="geometry"/></mxCell><mxCell id="n17" value="Create a server session and signed token; reset the failed attempts; log LOGIN_SUCCESS" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE7F8;strokeColor=#5B7DB1;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="372" width="130" height="96" as="geometry"/></mxCell><mxCell id="n18" value="Show a safe message; log LOGIN_FAILED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8D7D7;strokeColor=#C75C5C;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="562" y="225" width="176" height="74" as="geometry"/></mxCell><mxCell id="n19" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="633" y="163" width="34" height="34" as="geometry"/></mxCell><mxCell id="n20" value="Count the failed attempt and show the attempts left. On the 3rd in a row, lock the account for 1, then 5, then 15 minutes and log it" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8D7D7;strokeColor=#C75C5C;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="952" y="212" width="196" height="100" as="geometry"/></mxCell><mxCell id="n21" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#173A73;strokeWidth=2;fontColor=#173A73;" vertex="1" parent="1"><mxGeometry x="1033" y="163" width="34" height="34" as="geometry"/></mxCell><mxCell id="n22" value="Type the CAPTCHA characters" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fontSize=11;fillColor=#DFF3E3;strokeColor=#4DA862;fontColor=#1B2437;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="772" y="557" width="156" height="66" as="geometry"/></mxCell><mxCell id="n23" value="CAPTCHA correct?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fil